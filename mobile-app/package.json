{
  "name": "mobile-app",
  "version": "1.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prebuild": "node pre-build-check.js",
    "prebuild:play": "node pre-build-check.js --play-store",
    "build:android": "eas build --platform android --profile preview",
    "build:android:prod": "eas build --platform android --profile production",
    "build:play": "eas build --platform android --profile production",
    "submit:play": "eas submit --platform android --profile production --latest",
    "update:preview": "eas update --branch preview --message",
    "update:production": "eas update --branch production --message",
    "version:patch": "node scripts/version.js patch",
    "version:minor": "node scripts/version.js minor",
    "version:major": "node scripts/version.js major"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.2.0",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/stack": "^7.4.8",
    "@supabase/supabase-js": "^2.58.0",
    "bcryptjs": "^3.0.3",
    "expo": "~54.0.32",
    "expo-application": "^55.0.8",
    "expo-camera": "^17.0.8",
    "expo-font": "~14.0.9",
    "expo-image-picker": "^17.0.8",
    "expo-location": "~19.0.7",
    "expo-navigation-bar": "~5.0.10",
    "expo-secure-store": "^15.0.7",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-elements": "^3.4.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-vector-icons": "^10.3.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
